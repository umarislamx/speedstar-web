# Public site origin (used in metadata + contact emails)
NEXT_PUBLIC_SITE_URL=https://www.speedstar.app

# Cloudflare Turnstile — required in production (https://dash.cloudflare.com/?to=/:account/turnstile)
# Local `next dev` still works if both are empty. Production rejects every submit without the secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (https://resend.com)
RESEND_API_KEY=
# Verified sender, e.g. "SpeedStar <contact@speedstar.xyz>"
RESEND_FROM_EMAIL=SpeedStar <onboarding@resend.dev>
# Inbox that receives contact form notifications
CONTACT_TO_EMAIL=contact@speedstar.xyz

# Google Sheets via Vercel OIDC + Workload Identity Federation
# Submissions still succeed via email if these are missing.
# Do NOT set a service-account private key.
# 1. Enable Sheets API, IAM Credentials API, and STS API
# 2. Create WIF pool + OIDC provider that trusts https://oidc.vercel.com/<team>
# 3. Grant the Vercel production subject Workload Identity User on the SA
# 4. Share the spreadsheet with the service account email (Editor)
# 5. Header row: Timestamp | Name | Email | Subject | Message
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
GCP_SERVICE_ACCOUNT_EMAIL=
# Default audience from the WIF provider details page
GCP_AUDIENCE=
GOOGLE_SHEETS_SPREADSHEET_ID=
# Optional A1 range (default Sheet1!A:E)
GOOGLE_SHEETS_RANGE=Sheet1!A:E
