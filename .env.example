# Public site origin (used in metadata + contact emails)
NEXT_PUBLIC_SITE_URL=https://www.speedstar.app

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (https://resend.com)
RESEND_API_KEY=
# Verified sender, e.g. "SpeedStar <contact@speedstar.xyz>"
RESEND_FROM_EMAIL=SpeedStar <onboarding@resend.dev>
# Inbox that receives contact form notifications
CONTACT_TO_EMAIL=contact@speedstar.xyz

# Google Sheets (service account)
# 1. Create a Google Cloud service account with Sheets API enabled
# 2. Share the spreadsheet with the service account email (Editor)
# 3. Paste the private key with \n newlines escaped as \\n
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
# Optional A1 range (default Sheet1!A:F)
GOOGLE_SHEETS_RANGE=Sheet1!A:F
